# fourotwo facilitator configuration. Copy to `.env` and fill in.
# NEVER commit a real .env — service account keys are secrets (NFR security).

# ---- Server ----
PORT=4001
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Default chain ----
# Which adapter handles payments when the envelope network is ambiguous.
# AD-2: Casper is primary, Base is the fallback insurance path.
DEFAULT_NETWORK=casper

# ---- Casper (primary) ----
CASPER_NODE_RPC=https://rpc.testnet.casperlabs.io/rpc
CASPER_CHAIN_NAME=casper-test
# CSPR.cloud is used for on-chain reads (balances, deploy status).
CSPR_CLOUD_API_URL=https://api.testnet.cspr.cloud
CSPR_CLOUD_API_KEY=
# Deployed contract hashes (from contracts/deployed-addresses.json after M1-T2/T4).
KYX_REGISTRY_CONTRACT_HASH=
SETTLEMENT_VAULT_CONTRACT_HASH=
# Seed URef of the KyxRegistry Odra `state` dictionary (uref-<64hex>-NNN), from
# the contract's named keys. Set (with KYX_REGISTRY_CONTRACT_HASH) to enable
# on-chain trust reads; the HTTP KYX registry is the fallback.
KYX_REGISTRY_STATE_UREF=
# Algorithm of FACILITATOR_SECRET_KEY_PATH: ed25519 (01… keys) or secp256k1 (02…).
FACILITATOR_KEY_ALGORITHM=ed25519
# Gas for a record_settlement contract call, in motes (default 10 CSPR).
CASPER_SETTLEMENT_PAYMENT_MOTES=10000000000

# ---- Base (fallback) ----
BASE_RPC_URL=https://sepolia.base.org
BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ---- Facilitator service account ----
# Used to broadcast settlements and to sign settlement receipts.
# AD-8 / NFR: this is the facilitator's OWN key, never a developer's key.
#
# Provide the key ONE of two ways (FACILITATOR_SECRET_KEY wins if both set):
#  - FACILITATOR_SECRET_KEY: the key material directly — full PEM text, or
#    base64-of-the-PEM (recommended on PaaS like Render where multiline env
#    vars are awkward: `base64 -w0 secret_key.pem`).
#  - FACILITATOR_SECRET_KEY_PATH: path to a PEM file (handy for local dev).
FACILITATOR_SECRET_KEY=
FACILITATOR_SECRET_KEY_PATH=./keys/facilitator_secret_key.pem
# Hex-encoded ed25519 secret key used to sign settlement receipts (32 bytes).
# If unset, an ephemeral signing key is generated at boot (fine for local dev).
FACILITATOR_RECEIPT_SIGNING_KEY=

# ---- KYX Registry service (built in M3) ----
# Until M3 ships, /verify returns a trust_pending stub. Set this once the
# registry service is up to enrich verifications with live trust scores.
KYX_REGISTRY_URL=http://localhost:4002

# ---- Platform fees ----
# Basis-point fee accrued on every settled payment (10 = 0.10%). 0 disables.
FOUROTWO_FEE_BPS=10
# Platform account the fees are owed to (report at GET /fees).
# FOUROTWO_FEE_RECIPIENT=
# Fee ledger persistence (defaults to .data/fees.json).
# FEES_DATA_FILE=

# ---- Batched settlement ----
# Flush window for settlement_mode=batch (one on-chain vault record per flush).
BATCH_WINDOW_MS=60000
# Queue length that triggers an early flush.
BATCH_MAX_PENDING=200
# In auto mode, batch payments at or below this many motes (0 = auto stays direct).
BATCH_AUTO_THRESHOLD_MOTES=0

# ---- Auth / secrets (required in production) ----
# Bearer token the facilitator presents to the KYX registry when reporting
# settlements. Must match the registry's KYX_FACILITATOR_TOKEN.
# KYX_FACILITATOR_TOKEN=change-me
# Bearer token guarding admin/revenue endpoints (/fees, /batch/status, /batch/settle).
# FACILITATOR_ADMIN_TOKEN=change-me
# Receipt signing key (hex). REQUIRED in production: without it an ephemeral key
# is generated per boot and every previously issued receipt stops verifying.
# FACILITATOR_RECEIPT_SIGNING_KEY=

# ---- Durable storage (required for >1 replica / restart-safety) ----
# When set, verifications, the replay guard, the fee ledger and the batch queue
# are stored in MongoDB (atomic + shared across instances). Unset = in-memory
# only (single process, state lost on restart) - see review finding C6.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=fourotwo-facilitator

# ---- Fee collection (feature flag) ----
# Off by default: fees are only ACCRUED (owed), not moved. Turn on to sweep
# accrued fees on-chain to FOUROTWO_FEE_RECIPIENT via POST /fees/collect (admin).
# Requires FOUROTWO_FEE_RECIPIENT to be a Casper PUBLIC KEY (01.. / 02..) and a
# facilitator key. Native transfers have a 2.5 CSPR minimum, so collection only
# fires once accrued fees clear that floor.
# FEE_COLLECTION_ENABLED=false

# ---- Upstream facilitator (extend the CSPR.cloud Casper x402 Facilitator) ----
# When set, this facilitator DELEGATES on-chain settlement to the upstream Casper
# x402 Facilitator (https://x402-facilitator.cspr.cloud, docs.cspr.cloud/x402-
# facilitator-api) instead of running its own broadcaster. We keep trust gating,
# receipts, batching, vault records and fees; the upstream does the settle.
# NOTE: the upstream `exact` scheme verifies an EIP-712 signature over a CEP-18
# authorization - our current SDK signs native-CSPR ed25519, so payloads must be
# produced in the Casper-x402 scheme for the upstream to actually settle.
# UPSTREAM_FACILITATOR_URL=https://x402-facilitator.cspr.cloud
# UPSTREAM_FACILITATOR_ACCESS_TOKEN=            # CSPR.cloud access token
# UPSTREAM_FACILITATOR_NETWORK=casper:casper-test   # or casper:casper (mainnet)
# UPSTREAM_FACILITATOR_ASSET=                   # CEP-18 contract hash of the asset
# UPSTREAM_FACILITATOR_ASSET_METADATA={"name":"Cep18x402","version":"1","decimals":"2","symbol":"CSPR"}
# UPSTREAM_FACILITATOR_RESOURCE_URL=
